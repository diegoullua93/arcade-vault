# Copia este archivo a .env.local y completa los valores. Nunca subas .env.local.

# API key de Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# Correo del equipo que recibe los mensajes del formulario de /acerca-de.
# Con el remitente de pruebas de Resend debe ser el correo de tu cuenta de Resend.
CONTACT_TO_EMAIL=

# Remitente. En desarrollo: onboarding@resend.dev
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Supabase: URL del proyecto y clave publishable (Project Settings > API Keys).
# Ambas son públicas por diseño; nunca pongas aquí una secret key o service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
