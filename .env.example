# Copia este archivo a .env.local y completa los valores. Nunca subas .env.local.

# API key de Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# Correo del equipo que recibe los mensajes del formulario de /acerca-de.
# Con el remitente de pruebas de Resend debe ser el correo de tu cuenta de Resend.
CONTACT_TO_EMAIL=

# Remitente. En desarrollo: onboarding@resend.dev
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Supabase: URL del proyecto y clave publishable (Project Settings > API Keys).
# Ambas son públicas por diseño; nunca pongas aquí una secret key o service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública del sitio (sin barra final), p. ej. https://arcade-vault.com. Obligatoria en producción:
# se usa en los enlaces de los correos de Supabase y en el retorno de Google. En desarrollo es opcional
# (sin ella se usa el Host de la petición).
SITE_URL=

# Producción: usa la URL y la publishable key del proyecto Supabase de PRODUCCIÓN y un remitente de
# Resend con dominio verificado. Pasos completos en docs/produccion.md.

# Solo desarrollo: hosts desde los que abres `next dev` (p. ej. el móvil en tu red local),
# separados por comas y sin protocolo. Ejemplo: 192.168.0.13
ALLOWED_DEV_ORIGINS=
